# Database
DATABASE_URL=postgresql://gym:gym_password@localhost:5433/gym_tracker

# Server
PORT=3000
NODE_ENV=development

# JWT — generate with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-random-secret

# SMTP (for password reset emails)
# Gmail example (requires App Password: https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your.email@gmail.com

# Resend example:
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=resend
# SMTP_PASS=re_your_api_key
# SMTP_FROM=noreply@yourdomain.com

# Frontend URL (used for reset password links in emails)
APP_URL=http://localhost:5173

# CORS origin (should match APP_URL)
CLIENT_URL=http://localhost:5173
